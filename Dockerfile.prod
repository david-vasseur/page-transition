# ==========================================
# Stage 1 : builder
# ==========================================
FROM node:24-bookworm AS builder

WORKDIR /app

# Bride mémoire pour empêcher le crash du VPS pendant la compilation
ENV NODE_OPTIONS="--max-old-space-size=1024"

# Installer toutes les dépendances
COPY package*.json ./
RUN npm ci

# Copier tout le projet et builder
COPY . .
RUN npm run build

# ==========================================
# Stage 2 : runner
# ==========================================
FROM node:24-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV NEXT_TELEMETRY_DISABLED=1

# 1. Création de l'utilisateur rootless EN PREMIER
RUN groupadd -g 1002 nodejs && \
    useradd -u 1002 -g nodejs -s /bin/sh gvs3d

# 2. Dépendances de production avec attribution directe des droits
COPY --chown=gvs3d:nodejs package*.json ./
RUN npm ci --omit=dev

# 3. Récupération des artéfacts avec droits directs (zéro couche dupliquée)
COPY --chown=gvs3d:nodejs --from=builder /app/.next ./.next
COPY --chown=gvs3d:nodejs --from=builder /app/public ./public

# 4. Basculer sur l'utilisateur non-privilégié
USER gvs3d

EXPOSE 4002

CMD ["npm", "start"]
